{
  "name": "spectrum-operator",
  "version": "1.0.0",
  "private": true,
  "description": "Spectrum Operator — multi-mission unmanned systems & drone fleet management platform for PT Spectrum Group Indonesia.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "node scripts/build.mjs --preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "leaflet": "1.9.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
