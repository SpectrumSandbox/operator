{
  // Spectrum Operator — SPA served from Cloudflare Workers static assets, plus a
  // small Worker (worker/index.js) for /api/* (NavEarth airspace proxy).
  // Workers Builds (Git integration) runs `npm run build`, then `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spectrum-operator",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "operator.spectrumgroup.id", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
